name: Deploy to VPS

on:
  # Deploy when there's a push to the main branch
  push:
    branches:
      - main  
  # Allow manual deployment trigger from GitHub Actions
  workflow_dispatch:  

jobs:
  deploy:
    name: Deploy Code to VPS
    runs-on: ubuntu-latest

    steps:
      # Step 1: Check out the repository
      - name: Checkout Code
        uses: actions/checkout@v4

      # Step 2: Set up SSH for deployment to your VPS
      - name: Set up SSH Agent
        uses: webfactory/ssh-agent@v0.5.4
        with:
          ssh-private-key: ${{ secrets.VPS_SSH_KEY }}

      # Step 3: Perform deployment steps by SSHing into the VPS
      - name: Deploy Code to VPS
        run: |
          echo "Connecting to VPS and deploying code..."
          ssh -o StrictHostKeyChecking=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} << 'EOF'
            set -e
            echo "Navigating to the project directory..."
            cd /home/u766184830/domains/lucifercruz.com/public_html

            echo "Pulling the latest changes from the repository..."
            git fetch origin main
            git reset --hard origin/main

            echo "Activating the Python virtual environment..."
            source venv/bin/activate

            echo "Installing/upgrading dependencies from requirements.txt..."
            pip install -r requirements.txt --upgrade

            echo "Restarting the application using systemd..."
            sudo systemctl restart luxit

            echo "Deployment process completed successfully!"
          EOF
