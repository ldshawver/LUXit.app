name: Deploy to VPS

on:
  push:
    branches:
      - main  # Adjust this to the branch you want to trigger deployment from

jobs:
  deploy:
    name: Deploy Code to VPS
    runs-on: ubuntu-latest

    steps:
      # Step 1: Checkout the latest code
      - name: Checkout Code
        uses: actions/checkout@v3

      # Step 2: Set up the SSH agent
      - name: Set up SSH Agent
        uses: webfactory/ssh-agent@v0.5.4
        with:
          ssh-private-key: ${{ secrets.VPS_SSH_KEY }}

      # Step 3: Deploy Code to Target VPS
      - name: Deploy to VPS
        run: |
          ssh -o StrictHostKeyChecking=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} << 'EOF'
            # Navigate to the directory on the VPS
            cd /home/u766184830/domains/lucifercruz.com/public_html/
            
            # Make sure we have the latest code from GitHub
            git pull origin main
            
            # OPTIONAL: Install/Update dependencies (if necessary)
            # Assuming you're using Python
            source /etc/lux-marketing/lux.env
            python3 -m venv venv
            source venv/bin/activate
            pip install -r requirements.txt
            
            # Restart the application (adjust for your setup)
            sudo systemctl restart your_app.service
          EOF
