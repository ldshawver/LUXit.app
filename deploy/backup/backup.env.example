# /etc/luxit/backup.env  (install -m 0600). No secrets except rclone's config path.
BACKUP_GPG_RECIPIENT=backups@luxit.app
GNUPGHOME=/etc/luxit/backup-gnupg
BACKUP_DIR=/var/backups/luxit
RETAIN_DAYS=14
# Off-site (D-10): leave empty until the bucket exists; the healthcheck alerts while it is empty.
OFFSITE_CMD=/usr/local/sbin/luxit-backup-offsite.sh
OFFSITE_REMOTE=
RCLONE_CONFIG=/etc/luxit/backup-rclone.conf
